# ScamShield AI - Environment Configuration Template
# Free-Tier Default Mode: template explanations (no external API calls required)

# LLM Provider: gemini, groq, ollama, or template
LLM_PROVIDER=template
LLM_MODEL=gemini-1.5-flash
USE_LLM_EXPLANATION=false

# Free-Tier API Key (Optional when using LLM_PROVIDER=template or ollama)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Database URL (SQLite)
DATABASE_URL=sqlite:///./scamshield.db

# Frontend Config
VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8000
